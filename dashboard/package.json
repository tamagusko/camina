    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-from-mock.ts"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/config": "^0.2.1",
    "@vercel/functions": "^3.7.5",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.460.0",
    "maplibre-gl": "^4.7.1",
    "next": "^16.2.11",
    "next-auth": "^5.0.0-beta.25",
    "pmtiles": "^3.2.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "path-to-regexp@<6.3.0": "6.3.0",
      "vite@<6.4.3": "6.4.3",
      "postcss@<8.5.10": "8.5.10",
      "esbuild@<0.25.0": "0.25.12",
      "esbuild@>=0.27.3 <0.28.1": "0.25.12"
    }
  }
