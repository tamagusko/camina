{
  "name": "camina-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev --turbo",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-from-mock.ts"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/config": "^0.2.1",
    "@vercel/functions": "^3.7.5",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.460.0",
    "maplibre-gl": "^6.4.1",
    "next": "^16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "path-to-regexp@<6.3.0": "6.3.0",
      "vite@<6.4.3": "6.4.3",
      "esbuild@<0.25.0": "0.25.12",
      "esbuild@>=0.27.3 <0.28.1": "0.25.12",
      "postcss@<8.5.23": "8.5.23",
      "nanoid@<3.3.18": "3.3.19",
      "browserslist@<4.28.7": "4.28.7",
      "fflate@<0.8.3": "0.8.3",
      "postcss-selector-parser@<6.1.3": "6.1.3",
      "baseline-browser-mapping@<2.11.0": "2.11.0",
      "@auth/core@<0.41.3": "0.41.3",
      "@vitest/mocker@<4.1.11": "4.1.11"
    }
  }
}
