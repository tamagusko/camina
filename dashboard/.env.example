# Copy to .env.local and fill in.
# Never commit real secrets. Use `vercel env add` for preview/production.

# Production runtime: set live explicitly; mock is the local development default.
CAMINA_DATA_SOURCE=mock                  # 'mock' | 'live'

# Mock/dev only: folder name under data/mock/.
CAMINA_MOCK_CITY=dublin

# Mock/dev only: allowlisted Google accounts and optional admin accounts.
# An empty allowlist admits any Google account in local development.
CAMINA_DEV_ALLOWED_EMAILS=
CAMINA_DEV_ADMIN_EMAILS=
CAMINA_DEV_INGEST_TOKEN=                 # shared mock ingest token; live uses per-sensor tokens

# Dev-only UI convenience. Never set this in a production build: the build
# rejects it because this client-side flag bypasses admin auth.
# NEXT_PUBLIC_CAMINA_DEV_ADMIN=true

# Live runtime database (required when CAMINA_DATA_SOURCE=live).
DATABASE_URL=postgres://user:pass@host:5432/camina?sslmode=require
# Migration/provisioning CLI connection (falls back to DATABASE_URL).
DATABASE_URL_UNPOOLED=postgres://user:pass@host:5432/camina?sslmode=require
# Optional integration-test database; tests skip DB cases when unset.
DATABASE_URL_TEST=

# Auth.js v5 + Google provider (required for production sign-in).
AUTH_SECRET=                             # generate with: openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional Auth.js deployment overrides. Vercel normally detects its URL/host.
# AUTH_URL=http://localhost:3000
# AUTH_TRUST_HOST=true                   # set for trusted self-hosted proxy setups

# Optional ingest rate limiting in live mode; configure both for production
# when using Upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Production cron authentication (required for cron jobs; dev may omit).
VERCEL_CRON_SECRET=

# VERCEL_ENV, NODE_ENV and NEXT_PHASE are provided by Vercel/Next.js.
