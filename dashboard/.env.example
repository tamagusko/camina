# Copy to .env.local and fill in.
# Never commit real secrets. Use `vercel env add` for preview/production.

# Data source (see src/lib/data-source.ts)
CAMINA_DATA_SOURCE=mock                  # 'mock' (default in dev) | 'live'
CAMINA_MOCK_CITY=dublin                  # folder name under data/mock/

# Show the admin section (sensor IDs, GPS, install dates) in the street-click
# side panel without requiring Google sign-in. Dev-only convenience; in live
# mode this is gated by requireAdmin().
NEXT_PUBLIC_CAMINA_DEV_ADMIN=true

# Database (live mode only)
DATABASE_URL=postgres://user:pass@host:5432/camina?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:pass@host:5432/camina?sslmode=require

# Auth.js v5 + Google provider
AUTH_SECRET=                             # openssl rand -base64 32
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Basemap (Protomaps PMTiles URL)
PROTOMAPS_PMTILES_URL=                   # e.g. https://cdn.../dublin.pmtiles

# Observability (optional in dev)
SENTRY_DSN=

# Rate limiting (optional in dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron (validates caller)
VERCEL_CRON_SECRET=
