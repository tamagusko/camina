[Unit]
Description=CAMINA edge sensor daemon
Documentation=file:///opt/camina/docs/sensor_deployment.md
# Gate start-up on a synced clock (H5-clock): windows and idempotency keys are
# wall-clock derived, so a pre-NTP boot must not publish skewed timestamps.
After=time-sync.target network-online.target
Wants=time-sync.target network-online.target

[Service]
# Type=notify: the daemon signals READY=1 once start-up is complete and sends
# WATCHDOG=1 keep-alives from the main loop; a stall past WatchdogSec triggers
# an automatic restart (M8).
Type=notify
WatchdogSec=300
User=camina
Group=camina
WorkingDirectory=/opt/camina
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/camina/venv/bin/python -m src.camina.service.sensor_daemon --config /etc/camina/sensor.yaml
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=300
StartLimitBurst=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=camina-sensor

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/camina
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
